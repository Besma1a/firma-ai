# --- Required: get a free key at https://aistudio.google.com/apikey ---
GOOGLE_API_KEY=paste-your-gemini-key-here

# --- Optional (sensible defaults) ---
CLAUDE_MODEL=gemini-2.0-flash
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_STORE_DIR=./chroma_db
KB_DIR=./app/data/kb
SEED_JSON_PATH=./app/data/nabta_crops_seed.json
TOP_K=6
MAX_TOKENS=600

# --- Mock mode: set to "true" to skip LLM calls (returns stub responses) ---
# Useful when your frontend needs to integrate before you have the API key
MOCK_CLAUDE=false

# --- CORS: comma-separated list of allowed origins ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081